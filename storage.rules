rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(empresaId) {
      return firestore.get(
        /databases/(default)/documents/empresas/$(empresaId)/membros/$(request.auth.uid)
      );
    }

    function isMember(empresaId) {
      return signedIn()
        && memberDoc(empresaId).data.ativo == true;
    }

    match /empresas/{empresaId}/{allPaths=**} {
      allow read: if isMember(empresaId);
      allow write: if isMember(empresaId)
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
