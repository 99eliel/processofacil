rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /empresas/principal/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource == null
        || request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
