rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPrincipalWorkspace(empresaId) {
      return empresaId == 'principal';
    }

    function canUpdateRevision() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return (
        resource.data.status == 'rascunho'
        && request.resource.data.status in ['rascunho', 'em_validacao']
      ) || (
        resource.data.status == 'em_validacao'
        && request.resource.data.status in ['em_validacao', 'rascunho', 'padrao']
        && changed.hasOnly([
          'status',
          'aprovadoPor',
          'aprovadoEm',
          'alteradoEm',
          'alteradoPor'
        ])
      ) || (
        resource.data.status == 'padrao'
        && request.resource.data.status == 'obsoleta'
        && changed.hasOnly([
          'status',
          'alteradoEm',
          'alteradoPor'
        ])
      );
    }

    match /empresas/{empresaId} {
      allow read, create, update: if isPrincipalWorkspace(empresaId);
      allow delete: if false;

      match /auditoria/{docId} {
        allow read, create: if isPrincipalWorkspace(empresaId);
        allow update, delete: if false;
      }

      match /inspecoes/{docId} {
        allow read, create: if isPrincipalWorkspace(empresaId);
        allow update, delete: if false;
      }

      match /produtos/{produtoCodigo}/revisoes/{revisaoId} {
        allow read, create: if isPrincipalWorkspace(empresaId);
        allow update: if isPrincipalWorkspace(empresaId) && canUpdateRevision();
        allow delete: if false;
      }

      match /{collectionName}/{docId} {
        allow read, create, update: if isPrincipalWorkspace(empresaId)
          && collectionName != 'auditoria'
          && collectionName != 'inspecoes';
        allow delete: if false;
      }

      match /{collectionName}/{docId}/{document=**} {
        allow read, create, update: if isPrincipalWorkspace(empresaId)
          && collectionName != 'auditoria'
          && collectionName != 'inspecoes'
          && collectionName != 'produtos';
        allow delete: if false;
      }
    }

    match /usuarios/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
