rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() { return signedIn() && request.auth.token.superadmin == true; }
    function memberPath(empresaId) {
      return /databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid);
    }
    function isMember(empresaId) {
      return signedIn() && exists(memberPath(empresaId)) && get(memberPath(empresaId)).data.ativo == true;
    }
    function memberProfiles(empresaId) { return get(memberPath(empresaId)).data.perfis; }
    function hasAnyProfile(empresaId, perfis) {
      return isSuperAdmin() || (isMember(empresaId) && memberProfiles(empresaId).hasAny(perfis));
    }
    function canWriteOperational(empresaId) {
      return hasAnyProfile(empresaId, ['admin','desenvolvimento','planejamento','ppcp','producao','qualidade']);
    }

    match /empresas/{empresaId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin() || isMember(empresaId);
      allow update: if isSuperAdmin() || hasAnyProfile(empresaId, ['admin']);
      allow delete: if false;

      match /membros/{uid} {
        allow read: if isSuperAdmin() || isMember(empresaId);
        allow create, update: if isSuperAdmin() || hasAnyProfile(empresaId, ['admin']);
        allow delete: if false;
      }

      match /configuracoes/{docId} {
        allow read: if isMember(empresaId) || isSuperAdmin();
        allow create, update: if hasAnyProfile(empresaId, ['admin']);
        allow delete: if false;
      }

      match /{collectionName}/{docId} {
        allow read: if isMember(empresaId) || isSuperAdmin();
        allow create, update: if collectionName != 'membros'
          && collectionName != 'configuracoes'
          && canWriteOperational(empresaId);
        allow delete: if false;
      }

      match /{collectionName}/{docId}/{document=**} {
        allow read: if isMember(empresaId) || isSuperAdmin();
        allow write: if collectionName != 'membros'
          && collectionName != 'configuracoes'
          && canWriteOperational(empresaId);
      }
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
